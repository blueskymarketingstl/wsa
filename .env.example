# Configure these in SiteGround's Environment Variables panel. No values here are credentials.
SITE_URL=https://weldonspringautoandtire.com
# Set true on a temporary/staging domain; false after approving production indexing.
NOINDEX=true
INQUIRY_EMAIL=michael@blueskymarketingstl.com
# Set SMTP values securely in SiteGround; do not commit them or send them in chat.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Optional: stable random security key if running several application instances.
CSRF_SECRET=
# Optional: existing appointment link is used when this value is absent.
BOOKING_URL=https://aops.cc/jacobi-car-care-llc-dba-weldon-springs-auto-booking
# SiteGround supplies PORT; the local default is 3000.
