<main id="main">
<section class="page-hero"><div class="container"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><% if(page.parent){ %><a href="/auto-repair/">Auto repair</a><span>/</span><% } %><span><%= page.title %></span></nav><p class="eyebrow"><%= page.eyebrow %></p><h1><%= page.title %></h1><p class="page-intro"><%= page.description %></p></div><span class="hero-watermark" aria-hidden="true">WS /</span></section>
<% if(page.slug==='contact'){ %>
<section class="section container contact-grid"><div><p class="eyebrow">We’re here to help.</p><h2>Send us a note.</h2><%- page.content %><%- include('partials/contact') %></div><aside class="contact-card"><h2>Come on by.</h2><address>818 O’Fallon Road<br>St. Charles, MO 63304</address><a class="text-link" href="tel:16364986600"><%- icon('phone') %> (636) 498-6600</a><p>Monday–Friday<br><strong>8:00am–5:00pm</strong><br>Saturday & Sunday: Closed</p><a class="text-link" href="<%= directions %>">Get directions <%- icon('arrow') %></a><hr><span class="wifi-badge"><%- icon('wifi') %> Free guest Wi-Fi while you wait.</span><p>Need an appointment?</p><%- button('Book a visit') %></aside></section>
<% } else if(page.slug==='book'){ %>
<section class="section container booking-section"><div class="prose"><%- page.content %></div><% if(bookingEmbed){ %><div class="booking-embed"><%- bookingEmbed %></div><% }else{ %><div class="booking-card"><span class="booking-icon"><%- icon('clock') %></span><h2>Let’s find a time that works.</h2><p>Use our online scheduling service to choose your visit.</p><a class="button" href="<%= bookingUrl %>">Continue to online booking <%- icon('arrow') %></a><p class="form-help">You’ll continue to our appointment provider to complete your request.</p></div><% } %><p>Prefer a friendly voice? <a href="tel:16364986600">Call (636) 498-6600</a>. Free guest Wi-Fi is available during your visit.</p></section>
<% }else if(page.slug==='auto-repair'){ %>
<section class="section container"><div class="prose intro-prose"><%- page.content %></div><%- serviceGrid() %></section>
<% }else if(page.slug==='sitemap'){ %>
<section class="section container prose"><%- page.content %><ul><% for(const item of pages){ %><li><a href="<%= item.path %>"><%= item.title %></a></li><% } %></ul></section>
<% }else{ %>
<section class="section container article-grid"><article class="prose"><%- page.content %></article><aside class="service-sidebar"><div class="sidebar-photo"><%- image(page.image||'trust.webp',page.title+' at Weldon Spring Automotive & Tire') %></div><div class="sidebar-panel"><p class="eyebrow">Good care is close to home.</p><h2>Let’s take care of it.</h2><p>Expert advice and a friendly team in Weldon Spring & St. Charles.</p><%- button() %><a class="sidebar-phone" href="tel:16364986600">(636) 498-6600</a><span class="wifi-badge"><%- icon('wifi') %> Free guest Wi-Fi</span></div><nav class="related-services" aria-label="More auto services"><h3>Explore our services</h3><% for(const service of services){ %><a <%- page.path===service.path?'aria-current="page"':'' %> href="<%= service.path %>"><%= service.title %> <%- icon('arrow') %></a><% } %></nav></aside></section>
<% } %>
</main>
