<main id="main"><section class="page-hero"><div class="container"><p class="eyebrow">Find the care you’re looking for.</p><h1>Let’s find it.</h1><p>Search results for “<%= query %>”</p><form role="search" class="page-search" method="get" action="/"><label for="results-query" class="screen-reader-text">Search the website</label><input id="results-query" name="s" type="search" value="<%= query %>" placeholder="Search services, symptoms, or tips" required><button class="button">Search <%- icon('search') %></button></form></div></section><section class="section container search-page-results"><% if(results.length){for(const item of results){ %><article><p class="eyebrow"><%= item.parent?'Auto service':'From your neighborhood shop' %></p><h2><a href="<%= item.path %>"><%= item.title %> <%- icon('arrow') %></a></h2><p><%= item.excerpt %></p></article><% }}else{ %><h2>No matches yet.</h2><p>Try “brakes,” “tires,” “battery,” or “maintenance.” You can also <a href="/auto-repair/">browse every service</a> or call <a href="tel:16364986600">(636) 498-6600</a>.</p><% } %></section></main>
